#: data/org.ayatana.indicator.bluetooth.gschema.xml:1
msgid "Bluetooth indicator in the menu bar."
msgstr "រូបតំណាង Bluetooth នៅក្នុងរបារម៉ឺនុយ."

#: data/org.ayatana.indicator.bluetooth.gschema.xml:2
msgid "Whether or not to show the Bluetooth indicator in the menu bar."
msgstr "ថាតើត្រូវបង្ហាញរូបតំណាង Bluetooth នៅក្នុងរបារម៉ឺនុយ ឬអត់."

#: src/agent.vala:45
#, c-format
msgid "Pair with %s?"
msgstr "ផ្គូផ្គងជាមួយ %s?"

#: src/agent.vala:78
msgid "Yes"
msgstr "បាទ"

#: src/agent.vala:83
msgid "No"
msgstr "ទេ"

#: src/agent.vala:114
#, c-format
msgid "Allow %s to connect?"
msgstr "អនុញ្ញាតឱ្យ %s ភ្ជាប់?"

#: src/agent.vala:115
msgid "Allow the Bluetooth device to access a Bluetooth service?"
msgstr "អនុញ្ញាតឱ្យឧបករណ៍ Bluetooth ចូលប្រើសេវាកម្ម Bluetooth?"

#: src/agent.vala:131
msgid "Trust and authorize"
msgstr "ទុកចិត្ត និងអនុញ្ញាត"

#: src/agent.vala:139
msgid "Authorize"
msgstr "អនុញ្ញាត"

#: src/agent.vala:146
msgid "Do not authorize"
msgstr "កុំអនុញ្ញាត"

#: src/agent.vala:173
#, c-format
msgid "Are you sure you want to pair with PIN %06u?"
msgstr "តើអ្នកពិតជាចង់ផ្គូផ្គងដោយប្រើ PIN %06u មែនទេ?"

#: src/agent.vala:183
msgid "Are you sure you want to pair with this device?"
msgstr "តើអ្នកពិតជាចង់ផ្គូផ្គងជាមួយឧបករណ៍នេះមែនទេ?"

#: src/agent.vala:192 src/agent.vala:209
msgid "Enter PIN for this device"
msgstr "បញ្ចូល PIN សម្រាប់ឧបករណ៍នេះ"

#: src/agent.vala:203
#, c-format
msgid "Enter the PIN code %s on the other device"
msgstr "បញ្ចូលកូដ PIN %s នៅលើឧបករណ៍មួយទៀត"

#: src/agent.vala:220
#, c-format
msgid "Enter the PIN %06u on the other device"
msgstr "បញ្ចូល PIN %06u នៅលើឧបករណ៍មួយទៀត"

#: src/bluez.vala:314
msgid "Unknown"
msgstr "មិនស្គាល់"

#: src/desktop.vala:114
msgid "Connection"
msgstr "ការភ្ជាប់"

#: src/desktop.vala:167
msgid "Send files…"
msgstr "ផ្ញើឯកសារ…"

#: src/desktop.vala:173
msgid "Keyboard Settings…"
msgstr "ការកំណត់ក្ដារចុច…"

#: src/desktop.vala:179
msgid "Mouse and Touchpad Settings…"
msgstr "ការកំណត់កណ្ដុរ និងបន្ទះប៉ះ…"

#: src/desktop.vala:186
msgid "Sound Settings…"
msgstr "ការកំណត់ សំឡេង…"

#: src/desktop.vala:234
msgid "Visible"
msgstr "អាចមើលឃើញ"

#. settings section
#: src/desktop.vala:247
msgid "Bluetooth Settings…"
msgstr "ការកំណត់ Bluetooth…"

#: src/phone.vala:45
msgid "Bluetooth settings…"
msgstr "ការកំណត់ Bluetooth…"

#: src/profile.vala:91 src/profile.vala:179
msgid "Bluetooth"
msgstr "Bluetooth"

#: src/profile.vala:180
msgid "Bluetooth status & device connections"
msgstr "ស្ថានភាព Bluetooth និងការភ្ជាប់ឧបករណ៍"
