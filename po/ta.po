#: data/org.ayatana.indicator.bluetooth.gschema.xml:1
msgid "Bluetooth indicator in the menu bar."
msgstr "பட்டியல் பட்டியில் நீலப்பல்அலை குறியீடு."

#: data/org.ayatana.indicator.bluetooth.gschema.xml:2
msgid "Whether or not to show the Bluetooth indicator in the menu bar."
msgstr "பட்டியல் பட்டியில் நீலப்பல்அலை குறியீடைக் காட்டவா அல்லது வேண்டாமா."

#: src/agent.vala:45
#, c-format
msgid "Pair with %s?"
msgstr "%s உடன் இணைக்கவும்?"

#: src/agent.vala:78
msgid "Yes"
msgstr "ஆம்"

#: src/agent.vala:83
msgid "No"
msgstr "இல்லை"

#: src/agent.vala:114
#, c-format
msgid "Allow %s to connect?"
msgstr "இணைக்க %s ஐ அனுமதி?"

#: src/agent.vala:115
msgid "Allow the Bluetooth device to access a Bluetooth service?"
msgstr "நீலப்பல்அலை சேவையை அணுக நீலப்பல்அலை சாதனத்தை அனுமதி?"

#: src/agent.vala:131
msgid "Trust and authorize"
msgstr "நம்பிக்கை மற்றும் அதிகாரமளி"

#: src/agent.vala:139
msgid "Authorize"
msgstr "அதிகாரமளி"

#: src/agent.vala:146
msgid "Do not authorize"
msgstr "அதிகாரம் அளிக்காதே"

#: src/agent.vala:173
#, c-format
msgid "Are you sure you want to pair with PIN %06u?"
msgstr "தன் அடையாள எண்(த அ எ)%06u மூலம் உறுதியாக இணைக்க விரும்புகிறீர்களா?"

#: src/agent.vala:183
msgid "Are you sure you want to pair with this device?"
msgstr "இந்தச் சாதனத்துடன் உறுதியாக இணைக்க விரும்புகிறீர்களா?"

#: src/agent.vala:192 src/agent.vala:209
msgid "Enter PIN for this device"
msgstr "இந்தச் சாதனத்திற்கான தனி அடையாள எண்(த அ எ)ஐ உள்ளிடவும்"

#: src/agent.vala:203
#, c-format
msgid "Enter the PIN code %s on the other device"
msgstr "மற்ற சாதனத்தில் தன் அடையாள எண்(த அ எ) ஐ %s உள்ளிடவும்"

#: src/agent.vala:220
#, c-format
msgid "Enter the PIN %06u on the other device"
msgstr "மற்ற சாதனத்தில் தன் அடையாள எண் (த அ எ)ஐ%06uஉள்ளிடவும்"

#: src/bluez.vala:314
msgid "Unknown"
msgstr "அறியாதது"

#: src/desktop.vala:114
msgid "Connection"
msgstr "இணைப்பு"

#: src/desktop.vala:167
msgid "Send files…"
msgstr "கோப்புகளை அனுப்பவும்…"

#: src/desktop.vala:173
msgid "Keyboard Settings…"
msgstr "விசைப்பலகை அமைப்புகள்…"

#: src/desktop.vala:179
msgid "Mouse and Touchpad Settings…"
msgstr "சொடுக்கி மற்றும் தொடுபலகை அமைப்புகள்…"

#: src/desktop.vala:186
msgid "Sound Settings…"
msgstr "ஒலி அமைப்புகள்…"

#: src/desktop.vala:234
msgid "Visible"
msgstr "காட்சிப்படும்"

#. settings section
#: src/desktop.vala:247
msgid "Bluetooth Settings…"
msgstr "நீலப்பல்அலை அமைப்புகள்…"

#: src/phone.vala:45
msgid "Bluetooth settings…"
msgstr "நீலப்பல் அலை அமைப்புகள்…"

#: src/profile.vala:91 src/profile.vala:179
msgid "Bluetooth"
msgstr "நீலப்பல்அலை"

#: src/profile.vala:180
msgid "Bluetooth status & device connections"
msgstr "நீலப்பல்அலை ன் நிலை மற்றும் சாதன இணைப்புகள்"
